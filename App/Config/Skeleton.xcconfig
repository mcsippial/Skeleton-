// Public app configuration. Only the Supabase URL and anon key belong here; every other
// key (Anthropic, in3D, Meshy, Terra/Junction) lives in Supabase Edge Function secrets.
//
// Put real values in Skeleton.local.xcconfig (gitignored). Copy the example to start:
//   cp App/Config/Skeleton.local.xcconfig.example App/Config/Skeleton.local.xcconfig
//
// With no values set the app runs end-to-end on mock services.

// The Skeleton Supabase project. Both values are public by design (Row Level Security protects the data).
// xcconfig treats "//" as a comment, hence "$()" between the slashes.
SUPABASE_URL = https:/$()/otintmfebdkxkrqgryut.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90aW50bWZlYmRreGtycWdyeXV0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMzOTgzMzYsImV4cCI6MjEwODk3NDMzNn0.dW54sgD5LgHekDIe5a9AxTJR1VRUXjcnBUbmyPCi0gg
// live = the Supabase project above (real sign-in, sync, Claude). mock = demo data on the device, no backend.
// To try demo data, set SKELETON_SERVICES = mock in Skeleton.local.xcconfig (or as a scheme environment variable).
SKELETON_SERVICES = live

// Signing. Set DEVELOPMENT_TEAM (and a bundle ID you own) in Skeleton.local.xcconfig.
PRODUCT_BUNDLE_IDENTIFIER = app.skeleton.ios
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Skeleton.local.xcconfig"
