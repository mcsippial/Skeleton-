# Edge Function secrets. Copy to supabase/.env (gitignored) for `supabase functions serve --env-file supabase/.env`,
# and set in production with `supabase secrets set --env-file supabase/.env`.
# Every service has a mock: leave a key empty and that service runs on mock data.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # edge functions only, never in the app
IN3D_API_KEY=
MESHY_API_KEY=
TERRA_API_KEY=
JUNCTION_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5  # configurable
AI_PROVIDER=mock                # mock | claude
